# Slack Bot (new Slack App for idea capture)
# Create at https://api.slack.com/apps
# Enable Socket Mode -> generate App-Level Token (xapp-...) with connections:write
# Add slash commands: /idea, /note, /ideas, /idea_to_blog, /idea_to_project,
#                     /idea_evaluate, /idea_done, /idea_archive, /idea_delete
# OAuth scopes: commands, chat:write
# Optional (emoji capture): reactions:read, channels:history, groups:history
SLACK_BOT_TOKEN=xoxb-your-idea-bot-token
SLACK_APP_TOKEN=xapp-your-idea-app-token

# GitHub -- for committing data files to this repo
# Create at https://github.com/settings/tokens (repo + workflow scopes)
GITHUB_TOKEN=ghp_your-token
GITHUB_REPO=anubhawsinha/slack_idea_capture

# Blog promotion -- triggers blog_post_workflow GitHub Actions
BLOG_WORKFLOW_REPO=anubhawsinha/blog_post_workflow
BLOG_WORKFLOW_BRANCH=main

# anuva.blog sync (local dev -- absolute path to anuva.blog on disk)
ANUVA_BLOG_DIR=/Users/anubhawsinha/Documents/github/anuva.blog

# anuva.blog sync (CI -- GitHub contents API)
# ANUVA_BLOG_REPO=anubhawsinha/anuva-blog
# ANUVA_BLOG_PAT=ghp_xxxx

# AI -- for idea evaluation (Perplexity research + Claude analysis) and GitHub repo READMEs
# Perplexity: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your-api-key
# Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key
